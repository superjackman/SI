el=\"Pretraining\"><rect class=\"main\" x=\"12\" y=\"1298\" width=\"170\" height=\"48\" rx=\"12\"></rect><text class=\"t\" style=\"font-size:15px\" x=\"97\" y=\"1319.5\">Pretraining</text><text class=\"s\" x=\"97\" y=\"1339.5\">Predict the next word</text><text x=\"172\" y=\"1314\" font-size=\"12\" text-anchor=\"middle\" class=\"zm-h\">🔍</text><g class=\"badge b-train\"><rect x=\"47\" y=\"1287\" width=\"100\" height=\"20\" rx=\"10\" fill=\"#f97316\"></rect><text x=\"97\" y=\"1301\">🔥 Updated in training</text></g><g class=\"badge b-use\"><rect x=\"63\" y=\"1287\" width=\"68\" height=\"20\" rx=\"10\" fill=\"#0ea5e9\"></rect><text x=\"97\" y=\"1301\">🔒 Read-only</text></g></g><g class=\"comp cat-trn\" data-id=\"sft\" data-train=\"yes\" tabindex=\"0\" role=\"button\" aria-label=\"Supervised fine-tuning (instruction tuning)\"><rect class=\"main\" x=\"198\" y=\"1298\" width=\"170\" height=\"48\" rx=\"12\"></rect><text class=\"t\" style=\"font-size:15px\" x=\"283\" y=\"1319.5\">Supervised fine-tuning</text><text class=\"s\" x=\"283\" y=\"1339.5\">Follow instructions</text><text x=\"358\" y=\"1342\" font-size=\"12\" text-anchor=\"middle\" class=\"zm-h\">🔍</text><g class=\"badge b-train\"><rect x=\"233\" y=\"1287\" width=\"100\" height=\"20\" rx=\"10\" fill=\"#f97316\"></rect><text x=\"283\" y=\"1301\">🔥 Updated in training</text></g><g class=\"badge b-use\"><rect x=\"249\" y=\"1287\" width=\"68\" height=\"20\" rx=\"10\" fill=\"#0ea5e9\"></rect><text x=\"283\" y=\"1301\">🔒 Read-only</text></g></g><g class=\"comp cat-trn\" data-id=\"pref\" data-train=\"yes\" tabindex=\"0\" role=\"button\" aria-label=\"Preference alignment (RLHF etc.)\"><rect class=\"main\" x=\"12\" y=\"1362\" width=\"170\" height=\"48\" rx=\"12\"></rect><text class=\"t\" style=\"font-size:15px\" x=\"97\" y=\"1383.5\">Preference alignment</text><text class=\"s\" x=\"97\" y=\"1403.5\">Human prefs, RLHF</text><text x=\"172\" y=\"1406\" font-size=\"12\" text-anchor=\"middle\" class=\"zm-h\">🔍</text><g class=\"badge b-train\"><rect x=\"47\" y=\"1351\" width=\"100\" height=\"20\" rx=\"10\" fill=\"#f97316\"></rect><text x=\"97\" y=\"1365\">🔥 Updated in training</text></g><g class=\"badge b-use\"><rect x=\"63\" y=\"1351\" width=\"68\" height=\"20\" rx=\"10\" fill=\"#0ea5e9\"></rect><text x=\"97\" y=\"1365\">🔒 Read-only</text></g></g><g class=\"comp cat-trn\" data-id=\"rlvr\" data-train=\"yes\" tabindex=\"0\" role=\"button\" aria-label=\"Reasoning RL (verifiable rewards)\"><rect class=\"main\" x=\"198\" y=\"1362\" width=\"170\" height=\"48\" rx=\"12\"></rect><text class=\"t\" style=\"font-size:15px\" x=\"283\" y=\"1383.5\">Reasoning RL</text><text class=\"s\" x=\"283\" y=\"1403.5\">Auto-graded rewards</text><text x=\"358\" y=\"1378\" font-size=\"12\" text-anchor=\"middle\" class=\"zm-h\">🔍</text><g class=\"badge b-train\"><rect x=\"233\" y=\"1351\" width=\"100\" height=\"20\" rx=\"10\" fill=\"#f97316\"></rect><text x=\"283\" y=\"1365\">🔥 Updated in training</text></g><g class=\"badge b-use\"><rect x=\"249\" y=\"1351\" width=\"68\" height=\"20\" rx=\"10\" fill=\"#0ea5e9\"></rect><text x=\"283\" y=\"1365\">🔒 Read-only</text></g></g><text class=\"lbl\" x=\"190\" y=\"1162\" font-size=\"12.5\" text-anchor=\"middle\" fill=\"#4d7c0f\">⬆ Training “produces” the parameters (weights) in</text><text class=\"lbl\" x=\"190\" y=\"1180\" font-size=\"12.5\" text-anchor=\"middle\" fill=\"#4d7c0f\">the LLM and encoders offline</text><rect x=\"4\" y=\"1476\" width=\"372\" height=\"236\" rx=\"16\" fill=\"#f1f5f9\" stroke=\"#e2e8f0\"></rect><text class=\"lbl\" x=\"16\" y=\"1498\" font-size=\"13\" font-weight=\"700\">⑥ Compute &amp; serving underneath</text><g class=\"comp cat-infra\" data-id=\"infra\" data-train=\"no\" tabindex=\"0\" role=\"button\" aria-label=\"Compute and serving\"><rect class=\"main\" x=\"14\" y=\"1516\" width=\"352\" height=\"56\" rx=\"12\"></rect><text class=\"t\" x=\"190\" y=\"1541.5\">Compute &amp; serving</text><text class=\"s\" x=\"190\" y=\"1561.5\">GPU · inference serving</text><text x=\"352\" y=\"1564\" font-size=\"13\" text-anchor=\"middle\" class=\"zm-h\">🔍</text></g><g class=\"comp cat-infra\" data-id=\"serve\" data-train=\"no\" tabindex=\"0\" role=\"button\" aria-label=\"Inference serving\"><rect class=\"main\" x=\"12\" y=\"1590\" width=\"170\" height=\"48\" rx=\"12\"></rect><text class=\"t\" style=\"font-size:15px\" x=\"97\" y=\"1611.5\">Inference serving</text><text class=\"s\" x=\"97\" y=\"1631.5\">Scheduling, streaming</text></g><g class=\"comp cat-infra\" data-id=\"kvcache\" data-train=\"no\" tabindex=\"0\" role=\"button\" aria-label=\"KV cache\"><rect class=\"main\" x=\"198\" y=\"1590\" width=\"170\" height=\"48\" rx=\"12\"></rect><text class=\"t\" style=\"font-size:15px\" x=\"283\" y=\"1611.5\">KV cache</text><text class=\"s\" x=\"283\" y=\"1631.5\">No recomputing earlier text</text><text x=\"358\" y=\"1606\" font-size=\"12\" text-anchor=\"middle\" class=\"zm-h\">🔍</text></g><g class=\"comp cat-infra\" data-id=\"batch\" data-train=\"no\" tabindex=\"0\" role=\"button\" aria-label=\"Batching (continuous batching)\"><rect class=\"main\" x=\"12\" y=\"1654\" width=\"170\" height=\"48\" rx=\"12\"></rect><text class=\"t\" style=\"font-size:15px\" x=\"97\" y=\"1675.5\">Batching</text><text class=\"s\" x=\"97\" y=\"1695.5\">Many requests at once</text></g><g class=\"comp cat-infra\" data-id=\"quant\" data-train=\"no\" tabindex=\"0\" role=\"button\" aria-label=\"Quantization\"><rect class=\"main\" x=\"198\" y=\"1654\" width=\"170\" height=\"48\" rx=\"12\"></rect><text class=\"t\" style=\"font-size:15px\" x=\"283\" y=\"1675.5\">Quantization</text><text class=\"s\" x=\"283\" y=\"1695.5\">Fewer bits per number</text></g><text class=\"lbl\" x=\"190\" y=\"1454\" font-size=\"12.5\" text-anchor=\"middle\" fill=\"#334155\">⬆ Inference serving loads these parameters on GPUs</text><text class=\"lbl\" x=\"190\" y=\"1472\" font-size=\"12.5\" text-anchor=\"middle\" fill=\"#334155\">and runs every computation</text></svg></div></div><details class=\"m-leg\"><summary>🎨 Legend: what the colours and dashed lines mean</summary><div class=\"legend\" id=\"legendT1\"><span><i style=\"--c:var(--io);--f:var(--io-f)\"></i>Input/output</span><span><i style=\"--c:#a21caf;--f:#fae8ff\"></i>Agent app layer</span><span><i style=\"--c:#dc2626;--f:#fee2e2\"></i>Guardrails</span><span><i style=\"--c:#4338ca;--f:#e0e7ff\"></i>LLM</span><span><i style=\"--c:var(--blk);--f:var(--blk-f)\"></i>Transformer block</span><span><i style=\"--c:#db2777;--f:#fce7f3\"></i>Multimodal encoding</span><span><i style=\"--c:#7e22ce;--f:#faf5ff\"></i>Generation (decoding)</span><span><i style=\"--c:#65a30d;--f:#ecfccb\"></i>Training system</span><span><i style=\"--c:#475569;--f:#e2e8f0\"></i>Compute &amp; serving</span><span><i class=\"dash\"></i>Dashed box = fixed computation/result, no learnable numbers</span></div></details></div><div class=\"card intro cc-closed\" data-cc=\"1\"><h3><button type=\"button\" class=\"cc-h\" aria-expanded=\"false\">📖 How to read this explainer</button></h3><div class=\"cc-body\"><p class=\"intro-h\" data-bz=\"1\"><b>AI in plain words: how software that “gets it done from one sentence” is built</b></p>\n\n<div class=\"bz bzp\" data-bz=\"1\"><ul class=\"pts\"><li>Start from one sentence you say and peel it back layer by layer: <b>Agent app</b> → <b>LLM</b> → <b>Transformer block</b> → <b>attention / feed-forward network</b>, then look at the neighbours: <b>multimodal</b>, <b>training</b> and <b>compute</b>.</li><li><b>Every box in the diagrams is tappable</b>: the popup explains what it does, where it starts from, how training adjusts it, what it does in use, why it is designed this way, why that works, and its limits — and you can jump “up” or “down” from there.</li></ul></div>\n<div class=\"hero-act\"><button class=\"btn hero\" data-tour=\"start\" data-l10n=\"\" data-en=\"🎬 Start the tour: follow one sentence in 15 steps\">🎬 Start the tour: follow one sentence in 15 steps</button><span data-l10n=\"\" data-en=\"Or use the tabs at the bottom and go in order: overview → detail\">Or use the tabs at the bottom and go in order: overview → detail</span></div>\n</div></div>\n<div class=\"card has-meta\" id=\"c_T1_0\" data-z=\"1\" data-zl=\"② Diagram\" data-nh=\"1\" data-cc=\"1\">\n<div class=\"cc-meta\"><span class=\"zl z2\">② Diagram</span></div><h2 data-l10n=\"\" data-en=\"Overview: six layers at work behind one sentence\"><button type=\"button\" class=\"cc-h\" aria-expanded=\"true\">Overview: six layers at work behind one sentence</button></h2><div class=\"cc-body\">\n<p class=\"lead\" data-l10n=\"\" data-en=\"Top to bottom: you → Agent app (ordinary code that orchestrates and takes action) → LLM (does the “thinking” and “writing”) → multimodal encoders/decoders (see, hear, draw) → training system (builds the skills offline) → compute and serving (makes it all actually run). &lt;b&gt;Tap any box for details; tap the ⤵ corner badge to drill down a level.&lt;/b&gt;\" data-bz=\"1\">Top to bottom: you → Agent app (ordinary code that orchestrates and takes action) → LLM (does the “thinking” and “writing”) → multimodal encoders/decoders (see, hear, draw) → training system (builds the skills offline) → compute and serving (makes it all actually run). <b>Tap any box for details; tap the ⤵ corner badge to drill down a level.</b></p>\n\n\n</div></div>\n<div class=\"card has-meta cc-closed\" id=\"walkCard\" data-z=\"3\" data-zl=\"③ Hands-on demo\" data-nh=\"1\" data-cc=\"1\">\n<div class=\"cc-meta\"><span class=\"zl z3\">③ Hands-on demo</span><span class=\"tag demo tag-s\" title=\"Sample data: tools and return values are made up\">Sample data</span></div><h3 data-l10n=\"\" data-en=\"🎬 End to end: “Check tomorrow’s weather in Hangzhou and add an umbrella reminder” &lt;span class=&quot;tag demo&quot;&gt;Sample data: tools and return values are made up&lt;/span&gt;\"><button type=\"button\" class=\"cc-h\" aria-expanded=\"false\">🎬 End to end: “Check tomorrow’s weather in Hangzhou and add an umbrella reminder”</button></h3><div class=\"cc-body\"><p class=\"tag-note\" data-bz=\"1\">ⓘ Sample data: tools and return values are made up</p>\n<p class=\"hint\" style=\"margin:0 0 6px\" data-l10n=\"\" data-en=\"Tap “Play” and the parts at work in the diagram above are &lt;b style=&quot;background:#fef9c3&quot;&gt;highlighted in yellow&lt;/b&gt;; you can also step through. Tap the “Triggered in this step” tags below for details.\" data-bz=\"1\">Tap “Play” and the parts at work in the diagram above are <b style=\"background:#fef9c3\">highlighted in yellow</b>; you can also step through. Tap the “Triggered in this step” tags below for details.</p>\n<div class=\"row\" style=\"margin-bottom:8px\"><button class=\"btn primary\" id=\"wPlay\" data-l10n=\"\" data-i18n=\"play\">▶ Play</button><button class=\"btn\" id=\"wNext\" data-l10n=\"\" data-en=\"Next ⏭\">Next ⏭</button><button class=\"btn ib\" id=\"wReset\" data-l10n=\"\" data-i18n=\"restart\" data-ic=\"1\" aria-label=\"Restart\" title=\"Restart\">⟲</button><span class=\"hint\" id=\"wInfo\" data-l10n=\"\" data-i18n=\"step_0\">Step 0</span></div>\n<div class=\"walk\">\n<div><div class=\"wstep\" id=\"wStep\" data-l10n=\"\" data-i18n=\"tap_play_or_next\">Tap “Play” or “Next” to start.</div><div class=\"fired\" id=\"wFired\"></div></div>\n<div class=\"log\" id=\"wLog\"></div>\n</div>\n</div></div>\n<div class=\"card has-meta cc-closed\" id=\"c_T1_1\" data-z=\"2\" data-zl=\"③ Details · why\" data-nh=\"1\" data-cc=\"1\">\n<div class=\"cc-meta\"><span class=\"zl zm\">③ Details · why</span></div><h3 data-l10n=\"\" data-en=\"Each layer in one sentence (tap a card for details)\"><button type=\"button\" class=\"cc-h\" aria-expanded=\"false\">Each layer in one sentence (tap a card for details)</button></h3><div class=\"cc-body\">\n<div class=\"grid\" id=\"t1cards\"><div class=\"mini\" data-id=\"user\" data-train=\"no\" style=\"--c:var(--io)\"><b>The user’s sentence</b><p data-bz=\"1\">Where the whole system starts: saying what you want in plain words.</p></div><div class=\"mini\" data-id=\"app\" data-train=\"no\" style=\"--c:#a21caf\"><b>Agent app layer</b><p data-bz=\"1\">Wraps the LLM into a program that “gets things done”: planning, tool calls, memory, loops, permissions.</p></div><div class=\"mini\" data-id=\"llm\" data-train=\"yes\" style=\"--c:#4338ca\"><span class=\"hb b-train\">🔥 Updated in training</span><span class=\"hb b-use\">🔒 Read-only</span><b>LLM (large language model)</b><p data-bz=\"1\">The agent’s “brain”: reads a passage of text and writes what comes next, one token at a time.</p></div><div class=\"mini\" data-id=\"mmenc\" data-train=\"yes\" style=\"--c:#db2777\"><span class=\"hb b-train\">🔥 Updated in training</span><span class=\"hb b-use\">🔒 Read-only</span><b>Multimodal encoders / decoders</b><p data-bz=\"1\">The LLM’s “eyes, ears and paintbrush”: turning images and sounds into tokens, or tokens back into images and sounds.</p></div><div class=\"mini\" data-id=\"trainsys\" data-train=\"yes\" style=\"--c:#65a30d\"><span class=\"hb b-train\">🔥 Updated in training</span><span class=\"hb b-use\">🔒 Read-only</span><b>Training system</b><p data-bz=\"1\">Where the model’s skills come from: pretraining → instruction tuning → preference alignment → reasoning RL.</p></div><div class=\"mini\" data-id=\"infra\" data-train=\"no\" style=\"--c:#475569\"><b>Compute and serving</b><p data-bz=\"1\">Makes the model actually run: GPU clusters, inference serving, KV cache, batching, quantization.</p></div></div>\n<div class=\"note\" data-l10n=\"\" data-en=\"Real products are not always layered this neatly: some build retrieval into the model service, others make multimodality a “native” all-in-one model. This diagram is a generic skeleton to aid understanding.\">Real products are not always layered this neatly: some build retrieval into the model service, others make multimodality a “native” all-in-one model. This diagram is a generic skeleton to aid understanding.</div>\n</div></div>\n<div class=\"card has-meta cc-closed\" id=\"c_T1_2\" data-z=\"2\" data-zl=\"③ Details · why\" data-nh=\"1\" data-cc=\"1\"><div class=\"cc-meta\"><span class=\"zl zm\">③ Details · why</span></div><h3 data-l10n=\"\" data-en=\"🧠 The logic underneath: why layer it like this\"><button type=\"button\" class=\"cc-h\" aria-expanded=\"false\">🧠 The logic underneath: why layer it like this</button></h3><div class=\"cc-body\"><div class=\"whylist\" data-ids=\"app,llm,mmenc,trainsys,infra\"><details class=\"whyitem\" style=\"--c:#a21caf\" open=\"\" data-dd=\"1\"><summary>Agent app layer<span>Wraps the LLM into a program that “gets things done”: planning, tool calls, memory, loops, permissions.</span></summary><div class=\"wi-act\"><button class=\"dd-c pri\" data-open=\"app\"><i aria-hidden=\"true\">↗</i><span>Open the full card</span></button></div><div class=\"whyrow\"><div class=\"why\"><h4>🧠 Why it’s designed this way (the logic underneath)</h4><p data-bz=\"1\">Separate “thinking” (the model) from “doing” (the program): the model is good at understanding and deciding, the program at precise execution, connecting systems and checking permissions. Each does what it’s good at.</p></div><div class=\"eff\"><h4>✅ Why this works</h4><p data-bz=\"1\">The model’s weaknesses (no up-to-date information, imprecise arithmetic, no access to external systems) are covered by tools; results come back before the model, and mistakes can be corrected, so it is far more reliable than a “one-shot answer”.</p></div></div><p class=\"lim\" data-bz=\"1\">⚠️ Limits / notes: With more steps errors accumulate; cost and waiting time grow with the number of loops; implementations differ a lot between products.</p></details><details class=\"whyitem\" style=\"--c:#4338ca\" data-dd=\"1\"><summary>LLM (large language model)<span>The agent’s “brain”: reads a passage of text and writes what comes next, one token at a time.</span></summary><div class=\"wi-act\"><button class=\"dd-c pri\" data-open=\"llm\"><i aria-hidden=\"true\">↗</i><span>Open the full card</span></button></div><div class=\"whyrow\"><div class=\"why\"><h4>🧠 Why it’s designed this way (the logic underneath)</h4><p data-bz=\"1\">Every task is unified as “continuing text”: answering, translating, coding and outputting tool-call JSON are all continuation. One format, one model, covering a vast range of tasks.</p></div><div class=\"eff\"><h4>✅ Why this works</h4><p data-bz=\"1\">Huge amounts of text force the model to compress grammar, common sense and patterns of reasoning into its parameters; later training teaches it to write according to instructions, in the right format and politely. Empirically, the bigger the scale and the better the data, the more capable it is.</p></div></div><p class=\"lim\" data-bz=\"1\">⚠️ Limits / notes: It “hallucinates” (sounds right but is wrong); its knowledge has a cutoff date; it can still make mistakes in precise calculation and long chains of reasoning.</p></details><details class=\"whyitem\" style=\"--c:#db2777\" data-dd=\"1\"><summary>Multimodal encoders / decoders<span>The LLM’s “eyes, ears and paintbrush”: turning images and sounds into tokens, or tokens back into images and sounds.</span></summary><div class=\"wi-act\"><button class=\"dd-c pri\" data-open=\"mmenc\"><i aria-hidden=\"true\">↗</i><span>Open the full card</span></button></div><div class=\"whyrow\"><div class=\"why\"><h4>🧠 Why it’s designed this way (the logic underneath)</h4><p data-bz=\"1\">Neural networks only understand numbers. As long as every modality becomes the same kind of “vector sequence”, the same powerful architecture (especially the Transformer) can handle them all, instead of building a separate machine for each kind of data.</p></div><div class=\"eff\"><h4>✅ Why this works</h4><p data-bz=\"1\">Methods like contrastive learning use huge numbers of “image–text” and “audio–text” pairs to pull different modalities into the same “meaning space”, which is why a model can “describe a picture” or generate an image from text.</p></div></div><p class=\"lim\" data-bz=\"1\">⚠️ Limits / notes: Cutting and compressing lose detail (small text, counts and exact positions often go wrong); architectures differ a lot between companies — only the common ideas are covered here.</p></details><details class=\"whyitem\" style=\"--c:#65a30d\" data-dd=\"1\"><summary>Training system<span>Where the model’s skills come from: pretraining → instruction tuning → preference alignment → reasoning RL.</span></summary><div class=\"wi-act\"><button class=\"dd-c pri\" data-open=\"trainsys\"><i aria-hidden=\"true\">↗</i><span>Open the full card</span></button></div><div class=\"whyrow\"><div class=\"why\"><h4>🧠 Why it’s designed this way (the logic underneath)</h4><p data-bz=\"1\">“Learning everything” is split into a relay: first lay the foundation with the cheapest, most plentiful data, then teach the rules with small amounts of high-quality data, and finally fine-tune behaviour with rewards. Each leg solves just one problem.</p></div><div class=\"eff\"><h4>✅ Why this works</h4><p data-bz=\"1\">Self-supervision means data scale is barely limited by human labelling; fine-tuning and alignment need relatively little data to “steer” general abilities in a useful direction — because the abilities are mostly already there after pretraining.</p></div></div><p class=\"lim\" data-bz=\"1\">⚠️ Limits / notes: The exact process differs between teams and changes fast; why each stage works is largely an empirical conclusion; training is extremely expensive.</p></details><details class=\"whyitem\" style=\"--c:#475569\" data-dd=\"1\"><summary>Compute and serving<span>Makes the model actually run: GPU clusters, inference serving, KV cache, batching, quantization.</span></summary><div class=\"wi-act\"><button class=\"dd-c pri\" data-open=\"infra\"><i aria-hidden=\"true\">↗</i><span>Open the full card</span></button></div><div class=\"whyrow\"><div class=\"why\"><h4>🧠 Why it’s designed this way (the logic underneath)</h4><p data-bz=\"1\">For every token it generates, an LLM has to “run through” billions of parameters, which is very demanding on memory bandwidth. The core engineering question: how to make one GPU serve more people at once, and each token cheaper.</p></div><div class=\"eff\"><h4>✅ Why this works</h4><p data-bz=\"1\">Batching lets one read of the weights serve many requests; the KV cache turns each step from “recompute the whole sentence” into “compute only the new token”; quantization makes the weights smaller and faster to read. Combined, they can cut costs a lot (the exact multiple varies by system).</p></div></div><p class=\"lim\" data-bz=\"1\">⚠️ Limits / notes: Optimizations often trade off against each other (speed vs quality vs memory); the numbers are empirical and change quickly with hardware and software.</p></details></div></div></div>\n<!--m2x--><div class=\"card has-meta cc-closed\" id=\"xComply\" data-z=\"2\" data-zl=\"③ Details · why\" data-nh=\"1\" data-cc=\"1\">\n<div class=\"cc-meta\"><span class=\"zl zm\">③ Details · why</span></div><h3><button type=\"button\" class=\"cc-h\" aria-expanded=\"false\">⚖️ Rules for using AI: copyright, privacy, content labels</button></h3><div class=\"cc-body\">\n<p class=\"lead\"><a data-open=\"xcomply\">Compliance: copyright, privacy, AI-content labelling</a>: an overview, not legal advice; check the latest official texts.</p>\n<ul class=\"pts\"><li><b>China’s main rules</b>: the Interim Measures for Generative AI Services took effect on 15 August 2023 and cover generative AI services offered to the public in China; training data and base models must be lawfully sourced and not infringe IP, and personal information needs consent or another legal basis.</li><li><b>Content labels</b>: the Measures for Labelling AI-Generated Content took effect on 1 September 2025. Explicit labels are text, sound or graphic notices users can clearly perceive; implicit labels sit in file metadata and include the content attribute, the provider’s name or code, and a content ID. Users publishing generated content should declare it and use the platform’s labelling feature.</li><li><b>Personal information</b>: the Personal Information Protection Law (in force since 1 November 2021) requires a clear purpose and minimum necessary collection; sensitive information (such as biometrics, health, financial accounts, whereabouts) needs separate consent; for automated decisions with a major effect on a person, they can ask for an explanation.</li><li><b>EU</b>: Article 50 of the AI Act requires telling people they are interacting with an AI system, marking generated audio, image, video and text in a machine-readable way, and disclosing deep fakes; under Article 113 it applies from 2 August 2026.</li><li><b>Copyright</b>: whether AI output can be copyrighted, and whether training on works is permissible, is still debated. The U.S. Copyright Office has published a report in parts (digital replicas, copyrightability, training).</li></ul>\n<div class=\"m-code\"><code>[AI-generated] This image was generated by AI</code></div>\n<p class=\"tag-note\"><span class=\"tag demo tag-s\" title=\"Illustrative\">Illustrative</span> The line above shows roughly what an explicit label looks like (illustrative); exact placement and form follow the measures and national standards.</p>\n<p class=\"k-src\">Sources: <a href=\"https://www.cac.gov.cn/2023-07/13/c_1690898327029107.htm\" target=\"_blank\" rel=\"noopener noreferrer\">CAC et al. 2023, Interim Measures for Generative AI Services (Chinese)</a> · <a href=\"https://www.cac.gov.cn/2025-03/14/c_1743654684782215.htm\" target=\"_blank\" rel=\"noopener noreferrer\">CAC et al. 2025, Measures for Labelling AI-Generated Content (Chinese)</a> · <a href=\"https://www.cac.gov.cn/2021-08/20/c_1631050028355286.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Personal Information Protection Law of the PRC (Chinese full text, CAC site)</a> · <a href=\"https://artificialintelligenceact.eu/article/50/\" target=\"_blank\" rel=\"noopener noreferrer\">EU AI Act, Article 50 (artificialintelligenceact.eu, unofficial consolidated text)</a> · <a href=\"https://www.copyright.gov/ai/\" target=\"_blank\" rel=\"noopener noreferrer\">U.S. Copyright Office, Copyright and Artificial Intelligence</a></p>\n</div></div><!--/m2x-->\n<div class=\"card quiz has-meta\" id=\"quizT1\" data-sec=\"T1\" data-z=\"3\" data-zl=\"❓ Quiz\" data-nh=\"1\"></div>\n<div class=\"ph-nav m-pn\" data-sec=\"T1\"><div class=\"pn-row\"><button type=\"button\" class=\"pn-b\" disabled=\"\" aria-label=\"Already the first stop\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><div class=\"pn-dots\"><button type=\"button\" class=\"dt on v\" data-go=\"T1\" aria-label=\"Word  1 : App overview (current)\"><i></i></button><button type=\"button\" class=\"dt  sub\" data-go=\"T2\" aria-label=\"Word  2 : Agent\"><i></i></button><button type=\"button\" class=\"dt  sub\" data-go=\"T3\" aria-label=\"Word  3 : LLM\"><i></i></button><button type=\"button\" class=\"dt  sub\" data-go=\"N\" aria-label=\"Word  4 : Neural Network Basics\"><i></i></button><button type=\"button\" class=\"dt \" data-go=\"T4\" aria-label=\"Word  5 : Transformer block\"><i></i></button><button type=\"button\" class=\"dt  sub\" data-go=\"T4a\" aria-label=\"Word  6 : Attention\"><i></i></button><button type=\"button\" class=\"dt \" data-go=\"T4b\" aria-label=\"Word  7 : FFN &amp; output\"><i></i></button><button type=\"button\" class=\"dt \" data-go=\"T5\" aria-label=\"Word  8 : MoE &amp; efficiency\"><i></i></button><button type=\"button\" class=\"dt \" data-go=\"T6\" aria-label=\"Word  9 : Multimodal\"><i></i></button><button type=\"button\" class=\"dt \" data-go=\"T7\" aria-label=\"Word  10 : Training &amp; RL\"><i></i></button><button type=\"button\" class=\"dt \" data-go=\"T8\" aria-label=\"Word  11 : Reference &amp; map\"><i></i></button></div><button type=\"button\" class=\"pn-b pri\" data-go=\"T2\" aria-label=\"Next stop: Agent\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></div><p class=\"pn-cap\">1 / 11 · Next stop: <button type=\"button\" class=\"pn-l\" data-go=\"T2\">Agent ›</button></p></div>"}
